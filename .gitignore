# Binaries. Anchored with a leading slash so they match ONLY the built binary
# at the repository root. Unanchored, `afy` also matched the cmd/afy/ SOURCE
# directory at any depth — git ignored the package holding main.go, so the
# commit that introduced it silently carried no source at all.
/afy
/afy.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build directories
/build/
/dist/

# Test binary
*.test

# Coverage
*.out
coverage.html

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# Temporary files
*.tmp
*.log

# Local config (don't commit credentials!)
.aetherfy/
